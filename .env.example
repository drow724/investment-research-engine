# Omit the portfolio ID to keep automatic Paper rebalancing disabled.
INVESTMENT_RUNTIME_DYNAMIC_PAPER_PORTFOLIO_ID=paper-v2.7-accuracy-fill-v2-main
INVESTMENT_RUNTIME_DYNAMIC_PAPER_EXECUTE=true
# Optional independent V2.8 Paper suite; requires paper-fill-v2. Blank disables it.
INVESTMENT_RUNTIME_V28_PAPER_EXPERIMENT_PREFIX=
INVESTMENT_RUNTIME_V29_PAPER_EXPERIMENT_PREFIX=
INVESTMENT_CRYPTO_PAPER_DATABASE=/app/sqlite/paper/crypto-trading.sqlite3
INVESTMENT_CRYPTO_OBSERVATION_DATABASE=/app/sqlite/observations/crypto-forward.sqlite3
INVESTMENT_RUNTIME_STATE_ROOT=/app/sqlite/runtime
INVESTMENT_RUNTIME_PAPER_EXECUTION_MODEL_VERSION=paper-fill-v2
INVESTMENT_RUNTIME_DYNAMIC_PAPER_INITIAL_CASH=1000000
INVESTMENT_RUNTIME_DYNAMIC_REBALANCE_CRON=5,20,35,50 * * * *
INVESTMENT_RUNTIME_DYNAMIC_STRATEGY_VERSION=dynamic-intraday-v2.7-accuracy-v1
# Optional decision-only challenger settings may be supplied as an all-or-none group.
INVESTMENT_RUNTIME_INTRADAY_MAXIMUM_ASSETS=300
INVESTMENT_RUNTIME_INTRADAY_SYNC_BUDGET_SECONDS=180
INVESTMENT_RUNTIME_DERIVATIVES_SNAPSHOT_CRON=3,18,33,48 * * * *
INVESTMENT_RUNTIME_DERIVATIVES_WEBSOCKET_ENABLED=true
INVESTMENT_CRYPTO_DERIVATIVES_DATABASE=/app/sqlite/observations/crypto-derivatives.sqlite3
INVESTMENT_BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
INVESTMENT_BINANCE_LIQUIDATION_WEBSOCKET_URL=wss://fstream.binance.com/market/ws/btcusdt@forceOrder
INVESTMENT_BINANCE_MARK_PRICE_WEBSOCKET_URL=wss://fstream.binance.com/market/ws/btcusdt@markPrice@1s
INVESTMENT_COINBASE_MARKET_WEBSOCKET_URL=wss://advanced-trade-ws.coinbase.com
INVESTMENT_RUNTIME_OBSERVATION_EXPERIMENT_ID=paper-v2.7-accuracy-fill-v2-YYYYMMDD
INVESTMENT_RUNTIME_OBSERVATION_DRAIN_EXPERIMENT_IDS_JSON=[]
INVESTMENT_RUNTIME_OBSERVATION_OUTCOME_CRON=10,25,40,55 * * * *
INVESTMENT_RUNTIME_STRATEGY_REVIEW_CRON=12 1 * * *
INVESTMENT_CRYPTO_STRATEGY_CONFIG_ROOT=config/strategies
INVESTMENT_CRYPTO_STRATEGY_REVIEW_ROOT=experiments/strategy-review
